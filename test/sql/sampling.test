# name: test/sql/sampling.test
# description: sampling functions - samples lists, seeding, and sample moments for every distribution
# group: [sql]

require stochastic

statement ok
SELECT setseed(0.42);

# --- samples(params..., n) returns a list of n samples ---

query II
SELECT len(dist_normal_samples(0, 1, 1000)), len(dist_poisson_samples(3, 0));
----
1000	0

query I
SELECT typeof(dist_poisson_samples(3, 2)) || ' ' || typeof(dist_bernoulli_samples(0.5, 2)) || ' ' || typeof(dist_normal_samples(0, 1, 2));
----
BIGINT[] BOOLEAN[] DOUBLE[]

query I
SELECT list_min(s) >= 1 AND list_max(s) <= 6 FROM (SELECT dist_uniform_int_samples(1, 6, 10000) AS s);
----
true

# Each row gets its own list, and parameters may vary per row
query II
SELECT n, len(dist_exponential_samples(rate, n)) FROM (VALUES (1.0, 3), (2.0, 0), (0.5, 7)) t(rate, n) ORDER BY n;
----
0	0
3	3
7	7

statement error
SELECT dist_normal_samples(0, 1, -1);
----
normal: n must be between 0 and 10000000, got -1

statement error
SELECT dist_normal_samples(0, 1, 10000001);
----
normal: n must be between 0 and 10000000

statement error
SELECT dist_normal_samples(0, -1, 3);
----
normal: stddev must be > 0, got -1

# --- setseed makes sampling reproducible, including in parallel ---

statement ok
SET threads = 8;

statement ok
SELECT setseed(0.25);

statement ok
CREATE TABLE a AS SELECT sum(dist_normal_sample(0, 1)) AS s, sum(dist_poisson_sample(3)) AS p FROM range(2000000);

statement ok
SELECT setseed(0.25);

statement ok
CREATE TABLE b AS SELECT sum(dist_normal_sample(0, 1)) AS s, sum(dist_poisson_sample(3)) AS p FROM range(2000000);

query I
SELECT a.s = b.s AND a.p = b.p FROM a, b;
----
true

statement ok
SELECT setseed(0.25);

statement ok
CREATE TABLE c AS SELECT dist_gamma_samples(2, 1, 5) AS s;

statement ok
SELECT setseed(0.25);

query I
SELECT s = dist_gamma_samples(2, 1, 5) FROM c;
----
true

statement ok
SET threads = 1;

# --- Sample moments match the distribution for every sampler ---
# Each check allows 6 standard errors for the mean and a relative tolerance for the variance.

query I
SELECT abs(avg(x) - dist_bernoulli_mean(0.3)) < 6 * dist_bernoulli_stddev(0.3) / sqrt(count(*))
   AND abs(var_samp(x) / dist_bernoulli_variance(0.3) - 1) < 0.1
FROM (SELECT unnest(dist_bernoulli_samples(0.3, 200000))::DOUBLE AS x);
----
true

query I
SELECT abs(avg(x) - dist_beta_mean(2.0, 5.0)) < 6 * dist_beta_stddev(2.0, 5.0) / sqrt(count(*))
   AND abs(var_samp(x) / dist_beta_variance(2.0, 5.0) - 1) < 0.1
FROM (SELECT unnest(dist_beta_samples(2.0, 5.0, 200000))::DOUBLE AS x);
----
true

