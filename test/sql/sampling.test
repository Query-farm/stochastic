# Cauchy and Student's t with low df have no variance: check the median and quartiles instead
query I
SELECT abs(median(x) - 1.0) < 0.02 AND abs(quantile_cont(x, 0.75) - dist_cauchy_quantile(1.0, 2.0, 0.75)) < 0.05
FROM (SELECT unnest(dist_cauchy_samples(1.0, 2.0, 200000)) AS x);
----
true

query I
SELECT abs(quantile_cont(x, 0.9) - dist_students_t_quantile(1.5, 0.9)) < 0.05
FROM (SELECT unnest(dist_students_t_samples(1.5, 200000)) AS x);
----
true
