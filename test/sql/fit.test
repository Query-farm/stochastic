query I
SELECT abs((SELECT dist_normal_fit(x).mean FROM normal_data) - (3.0330378000000002)) <= 1e-9 * greatest(1, abs(3.0330378000000002));
----
true

query I
SELECT abs((SELECT dist_normal_fit(x).stddev FROM normal_data) - (1.9034295210128287)) <= 1e-9 * greatest(1, abs(1.9034295210128287));
----
true

query I
SELECT abs((SELECT dist_lognormal_fit(x).mean FROM lognormal_data) - (0.44933756525930757)) <= 1e-9 * greatest(1, abs(0.44933756525930757));
----
true

query I
SELECT abs((SELECT dist_lognormal_fit(x).stddev FROM lognormal_data) - (0.791427466612956)) <= 1e-9 * greatest(1, abs(0.791427466612956));
----
true

