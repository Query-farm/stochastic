# The fitted parameters plug straight back into the distribution functions
query I
SELECT dist_normal_cdf(f.mean, f.stddev, f.mean) FROM (SELECT dist_normal_fit(x) AS f FROM normal_data);
----
0.5

query I
SELECT typeof(dist_gamma_fit(x)) FROM gamma_data;
----
STRUCT(shape DOUBLE, scale DOUBLE, log_likelihood DOUBLE, aic DOUBLE, bic DOUBLE)

# Fitting works per group and in parallel
statement ok
CREATE TABLE grouped AS SELECT i % 3 AS g, dist_normal_sample(10.0 * (i % 3), 1.0) AS x FROM range(300000) t(i);

query II
SELECT g, abs(dist_normal_fit(x).mean - 10.0 * g) < 0.05 FROM grouped GROUP BY g ORDER BY g;
----
0	true
1	true
2	true

query I
SELECT bool_and(abs(f.stddev - 1.0) < 0.02) FROM (SELECT dist_normal_fit(x) AS f FROM grouped GROUP BY g);
----
true

# NULLs are ignored; empty, single-value and constant samples give NULL
query I
SELECT dist_normal_fit(x).mean FROM (VALUES (1.0), (NULL), (3.0)) t(x);
----
2.0

query III
SELECT dist_normal_fit(x), dist_gamma_fit(x), dist_exponential_fit(x) FROM (SELECT 1.0 AS x WHERE false);
----
NULL	NULL	NULL

query II
SELECT dist_normal_fit(x), dist_beta_fit(x) FROM (VALUES (0.5), (0.5), (0.5)) t(x);
----
NULL	NULL

# Values outside the distribution's support are rejected
statement error
SELECT dist_gamma_fit(x) FROM (VALUES (1.0), (-1.0)) t(x);
----
gamma: fit values must be > 0, got -1

statement error
SELECT dist_beta_fit(x) FROM (VALUES (0.5), (1.0)) t(x);
----
beta: fit values must be between 0 and 1 (exclusive), got 1

statement error
SELECT dist_poisson_fit(x) FROM (VALUES (1.5)) t(x);
----
poisson: fit values must be non-negative integers, got 1.5

statement error
SELECT dist_bernoulli_fit(x) FROM (VALUES (2.0)) t(x);
----
bernoulli: fit values must be 0 or 1, got 2

statement error
SELECT dist_normal_fit(x) FROM (VALUES ('nan'::DOUBLE)) t(x);
----
normal: fit values must be finite, got nan

# AIC picks the distribution that generated the data
query I
SELECT (SELECT dist_gamma_fit(x).aic FROM gamma_data) < (SELECT dist_normal_fit(x).aic FROM gamma_data);
----
true

query I
SELECT (SELECT dist_cauchy_fit(x).aic FROM cauchy_data) < (SELECT dist_logistic_fit(x).aic FROM cauchy_data);
----
true

# Fits that collect the sample work per group and in parallel
query I
SELECT bool_and(abs(f.shape - 2.0) < 0.05 AND abs(f.scale - 3.0) < 0.05) FROM (
    SELECT dist_weibull_fit(dist_weibull_sample(2.0, 3.0)) AS f FROM range(400000) t(i) GROUP BY i % 4
);
----
true

query I
SELECT bool_and(abs(f.location - 1.0) < 0.05 AND abs(f.scale - 2.0) < 0.05) FROM (
    SELECT dist_cauchy_fit(dist_cauchy_sample(1.0, 2.0)) AS f FROM range(400000) t(i) GROUP BY i % 4
);
----
true

query I
SELECT bool_and(f.successes BETWEEN 4 AND 6) FROM (
    SELECT dist_negative_binomial_fit(dist_negative_binomial_sample(5, 0.3)) AS f FROM range(400000) t(i) GROUP BY i % 4
);
----
true

# The Weibull shape does not depend on the scale of the data, even near the limits of DOUBLE
query I
SELECT abs((SELECT dist_weibull_fit(x::DOUBLE * 1e300).shape FROM weibull_data) - (SELECT dist_weibull_fit(x).shape FROM weibull_data)) < 1e-9;
----
true

query I
SELECT abs((SELECT dist_weibull_fit(x::DOUBLE * 1e-300).scale FROM weibull_data) / (SELECT dist_weibull_fit(x).scale FROM weibull_data) * 1e300 - 1) < 1e-9;
----
true

# The fitted negative binomial plugs back in once successes is cast to BIGINT
query I
SELECT dist_negative_binomial_cdf(f.successes::BIGINT, f.prob, 1000) > 0.999 FROM (SELECT dist_negative_binomial_fit(x) AS f FROM negative_binomial_data);
----
true

# Samples without overdispersion have no negative binomial fit
query I
SELECT dist_negative_binomial_fit(x) FROM (VALUES (1.0), (2.0), (3.0)) t(x);
----
NULL

# Tails lighter than normal leave the Student's t degrees of freedom unbounded
query I
SELECT dist_students_t_fit(i / 100.0) FROM range(-100, 101) t(i);
----
NULL

# The number of binomial trials must be the same for every row of a group
statement error
SELECT dist_binomial_fit(x, t) FROM (VALUES (1.0, 5), (2.0, 6)) v(x, t);
----
binomial: distribution parameters must be the same for every row of a group

statement error
SELECT dist_binomial_fit(x, 5) FROM (VALUES (6.0)) v(x);
----
binomial: fit values must be integers between 0 and trials, got 6

statement error
SELECT dist_weibull_fit(x) FROM (VALUES (1.0), (0.0)) v(x);
----
weibull: fit values must be > 0, got 0

statement error
SELECT dist_negative_binomial_fit(x) FROM (VALUES (1.5)) v(x);
----
negative_binomial: fit values must be non-negative integers, got 1.5

query IIII
SELECT dist_weibull_fit(x), dist_cauchy_fit(x), dist_laplace_fit(x), dist_inverse_gaussian_fit(x) FROM (VALUES (2.0), (2.0)) t(x);
----
NULL	NULL	NULL	NULL

query I
SELECT dist_logistic_fit(x) FROM (SELECT 1.0 AS x WHERE false);
----
NULL

# Fit, then test the fit
query I
SELECT dist_gamma_ks_test(x, f.shape, f.scale).p_value > 0.05
FROM gamma_data, (SELECT dist_gamma_fit(x) AS f FROM gamma_data);
----
true


# Fits that overflow at extreme magnitudes report an error rather than NaN
statement error
SELECT dist_rayleigh_fit(x) FROM (VALUES (1e300), (1.5e300)) t(x);
----
rayleigh: the fit is not finite

statement error
SELECT dist_logistic_fit(x) FROM (VALUES (1e-300::DOUBLE), (2e-300::DOUBLE), (5e-324::DOUBLE)) t(x);
----
logistic: the fit is not finite