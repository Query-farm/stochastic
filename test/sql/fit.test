----
true

query I
SELECT abs((SELECT dist_rayleigh_fit(x).scale FROM rayleigh_data) - (2.063861824711692)) <= 1e-6 * greatest(1, abs(2.063861824711692));
----
true

query I
SELECT abs((SELECT dist_uniform_real_fit(x).min FROM uniform_real_data) - (-0.982276)) <= 1e-9 * greatest(1, abs(-0.982276));
----
true

query I
SELECT abs((SELECT dist_uniform_real_fit(x).max FROM uniform_real_data) - (2.992155)) <= 1e-9 * greatest(1, abs(2.992155));
----
true

query I
SELECT abs((SELECT dist_pareto_fit(x).scale FROM pareto_data) - (1.508944)) <= 1e-9 * greatest(1, abs(1.508944));
----
true

query I
SELECT abs((SELECT dist_pareto_fit(x).shape FROM pareto_data) - (3.0713848892458118)) <= 1e-9 * greatest(1, abs(3.0713848892458118));
----
true

query I
SELECT abs((SELECT dist_gamma_fit(x).shape FROM gamma_data) - (2.5359896643374533)) <= 1e-5 * greatest(1, abs(2.5359896643374533));
----
true

query I
SELECT abs((SELECT dist_gamma_fit(x).scale FROM gamma_data) - (1.2310576132213717)) <= 1e-5 * greatest(1, abs(1.2310576132213717));
----
true

query I
SELECT abs((SELECT dist_beta_fit(x).alpha FROM beta_data) - (2.1229027300402388)) <= 1e-4 * greatest(1, abs(2.1229027300402388));
----
true

query I
SELECT abs((SELECT dist_beta_fit(x).beta FROM beta_data) - (4.950325002451835)) <= 1e-4 * greatest(1, abs(4.950325002451835));
----
true

# The fitted parameters plug straight back into the distribution functions
query I
SELECT dist_normal_cdf(f.mean, f.stddev, f.mean) FROM (SELECT dist_normal_fit(x) AS f FROM normal_data);
----
0.5

query I
SELECT typeof(dist_gamma_fit(x)) FROM gamma_data;
----
STRUCT(shape DOUBLE, scale DOUBLE)

# Fitting works per group and in parallel
statement ok
CREATE TABLE grouped AS SELECT i % 3 AS g, dist_normal_sample(10.0 * (i % 3), 1.0) AS x FROM range(300000) t(i);

query II
SELECT g, abs(dist_normal_fit(x).mean - 10.0 * g) < 0.05 FROM grouped GROUP BY g ORDER BY g;
----
0	true
1	true
2	true

query I
SELECT bool_and(abs(f.stddev - 1.0) < 0.02) FROM (SELECT dist_normal_fit(x) AS f FROM grouped GROUP BY g);
----
true

# NULLs are ignored; empty, single-value and constant samples give NULL
query I
SELECT dist_normal_fit(x).mean FROM (VALUES (1.0), (NULL), (3.0)) t(x);
----
2.0

query III
SELECT dist_normal_fit(x), dist_gamma_fit(x), dist_exponential_fit(x) FROM (SELECT 1.0 AS x WHERE false);
----
NULL	NULL	NULL

query II
SELECT dist_normal_fit(x), dist_beta_fit(x) FROM (VALUES (0.5), (0.5), (0.5)) t(x);
----
NULL	NULL

# Values outside the distribution's support are rejected
statement error
SELECT dist_gamma_fit(x) FROM (VALUES (1.0), (-1.0)) t(x);
----
gamma: fit values must be > 0, got -1

statement error
SELECT dist_beta_fit(x) FROM (VALUES (0.5), (1.0)) t(x);
----
beta: fit values must be between 0 and 1 (exclusive), got 1

statement error
SELECT dist_poisson_fit(x) FROM (VALUES (1.5)) t(x);
----
poisson: fit values must be non-negative integers, got 1.5

statement error
SELECT dist_bernoulli_fit(x) FROM (VALUES (2.0)) t(x);
----
bernoulli: fit values must be 0 or 1, got 2

statement error
SELECT dist_normal_fit(x) FROM (VALUES ('nan'::DOUBLE)) t(x);
----
normal: fit values must be finite, got nan

# Fit, then test the fit
query I
SELECT dist_gamma_ks_test(x, f.shape, f.scale).p_value > 0.05
FROM gamma_data, (SELECT dist_gamma_fit(x) AS f FROM gamma_data);
----
true
