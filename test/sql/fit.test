----
true

query I
SELECT abs((SELECT dist_poisson_fit(x).rate FROM poisson_data) - (4.383333333333334)) <= 1e-9 * greatest(1, abs(4.383333333333334));
----
true

query I
SELECT abs((SELECT dist_bernoulli_fit(x).prob FROM bernoulli_data) - (0.26666666666666666)) <= 1e-9 * greatest(1, abs(0.26666666666666666));
----
true

query I
