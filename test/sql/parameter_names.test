# name: test/sql/parameter_names.test
# description: distribution parameter names must not collide with call parameter names
# group: [sql]

require stochastic

# DuckDB makes duplicate signature names unique by appending _<position>, so a
# distribution parameter that shares a name with the evaluation point (x) or the
# quantile probability (p) shows up as e.g. x_3. No stochastic function may have one.
query II
SELECT function_name, parameters
FROM duckdb_functions()
WHERE function_name LIKE 'dist\_%' ESCAPE '\'
  AND len(list_filter(parameters, lambda name: regexp_matches(name, '_[0-9]+$'))) > 0
ORDER BY ALL;
----

query II
SELECT DISTINCT function_name, parameters
FROM duckdb_functions()
WHERE function_name IN ('dist_cauchy_pdf', 'dist_cauchy_quantile', 'dist_cauchy_median')
ORDER BY ALL;
----
dist_cauchy_median	[location, scale]
dist_cauchy_pdf	[location, scale, x]
dist_cauchy_quantile	[location, scale, p]
