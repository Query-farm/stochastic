# name: test/sql/triangular.test
# description: triangular distribution, checked against SciPy
# group: [sql]

require stochastic

query I
SELECT abs(dist_triangular_pdf(0.0, 0.5, 1.0, 0.25) - (1.0)) <= 1e-8 * greatest(1, abs(1.0));
----
true

query I
SELECT abs(dist_triangular_cdf(0.0, 0.5, 1.0, 0.25) - (0.125)) <= 1e-8 * greatest(1, abs(0.125));
----
true

query I
SELECT abs(dist_triangular_cdf_complement(0.0, 0.5, 1.0, 0.25) - (0.875)) <= 1e-8 * greatest(1, abs(0.875));
----
true

query I
SELECT abs(exp(dist_triangular_log_pdf(0.0, 0.5, 1.0, 0.25)) - (1.0)) <= 1e-8 * greatest(1, abs(1.0));
----
true

query I
SELECT abs(dist_triangular_quantile(0.0, 0.5, 1.0, 0.95) - (0.841886116991581)) <= 1e-8 * greatest(1, abs(0.841886116991581));
----
true

query I
SELECT abs(dist_triangular_quantile_complement(0.0, 0.5, 1.0, 0.05) - (0.841886116991581)) <= 1e-8 * greatest(1, abs(0.841886116991581));
----
true

query I
SELECT abs(dist_triangular_cdf(0.0, 0.5, 1.0, dist_triangular_quantile(0.0, 0.5, 1.0, 0.3)) - (0.3)) <= 1e-9 * greatest(1, abs(0.3));
----
true

query I
SELECT abs(dist_triangular_mean(0.0, 0.5, 1.0) - (0.5)) <= 1e-8 * greatest(1, abs(0.5));
----
true

query I
SELECT abs(dist_triangular_variance(0.0, 0.5, 1.0) - (0.041666666666666664)) <= 1e-8 * greatest(1, abs(0.041666666666666664));
----
true

query I
SELECT abs(dist_triangular_median(0.0, 0.5, 1.0) - (0.5)) <= 1e-8 * greatest(1, abs(0.5));
----
true

query I
SELECT abs(dist_triangular_skewness(0.0, 0.5, 1.0) - (-0.0)) <= 1e-6 * greatest(1, abs(-0.0));
----
true

query I
SELECT abs(dist_triangular_hazard(0.0, 0.5, 1.0, 0.25) - (1.1428571428571428)) <= 1e-8 * greatest(1, abs(1.1428571428571428));
----
true

query I
SELECT typeof(dist_triangular_sample(0.0, 0.5, 1.0));
----
DOUBLE

query I
SELECT abs(avg(s) - dist_triangular_mean(0.0, 0.5, 1.0)) < 6 * dist_triangular_stddev(0.0, 0.5, 1.0) / sqrt(count(*))
FROM (SELECT unnest(dist_triangular_samples(0.0, 0.5, 1.0, 200000)) AS s);
----
true

query I
SELECT abs(var_samp(s) / dist_triangular_variance(0.0, 0.5, 1.0) - 1) < 0.1
FROM (SELECT unnest(dist_triangular_samples(0.0, 0.5, 1.0, 200000)) AS s);
----
true

query I
SELECT abs(quantile_cont(s, 0.8) - dist_triangular_quantile(0.0, 0.5, 1.0, 0.8)) < 0.02 * greatest(1, abs(dist_triangular_quantile(0.0, 0.5, 1.0, 0.8)))
FROM (SELECT unnest(dist_triangular_samples(0.0, 0.5, 1.0, 200000)) AS s);
----
true
