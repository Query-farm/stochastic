# name: test/sql/normal.test
# description: test normal distribution
# group: [sql]

require stochastic

# Test normal PDF
query R
SELECT round(dist_normal_pdf(0.0, 1.0, 0.0), 6);
----
0.398942

query R
SELECT round(dist_normal_pdf(0.0, 1.0, 1.0), 6);
----
0.241971

query R
SELECT round(dist_normal_pdf(0.0, 1.0, -1.0), 6);
----
0.241971

# Test normal log PDF
query R
SELECT round(dist_normal_log_pdf(0.0, 1.0, 0.0), 6);
----
-0.918939

# Test normal CDF
query R
SELECT round(dist_normal_cdf(0.0, 1.0, 0.0), 6);
----
0.500000

query R
SELECT round(dist_normal_cdf(0.0, 1.0, 1.0), 6);
----
0.841345

query R
SELECT round(dist_normal_cdf(0.0, 1.0, -1.0), 6);
----
0.158655

# Test normal CDF complement
query R
SELECT round(dist_normal_cdf_complement(0.0, 1.0, 0.0), 6);
----
0.500000

# Verify CDF + CDF complement = 1
query R
SELECT round(dist_normal_cdf(0.0, 1.0, 1.0) + dist_normal_cdf_complement(0.0, 1.0, 1.0), 1);
----
1.0

# Test normal log CDF
query R
SELECT round(dist_normal_log_cdf(0.0, 1.0, 1.0), 6);
----
-0.172754

# Test normal log CDF complement
query R
SELECT round(dist_normal_log_cdf_complement(0.0, 1.0, 1.0), 6);
----
-1.841022

# Test normal quantile (inverse CDF)
query R
SELECT round(dist_normal_quantile(0.0, 1.0, 0.5), 6);
----
0.000000

query R
SELECT round(dist_normal_quantile(0.0, 1.0, 0.95), 6);
----
1.644854

# Test normal quantile complement
query R
SELECT round(dist_normal_quantile_complement(0.0, 1.0, 0.05), 6);
----
1.644854

# Test normal hazard function
query R
SELECT round(dist_normal_hazard(0.0, 1.0, 0.0), 6);
----
0.797885

# Test normal cumulative hazard function
query R
SELECT round(dist_normal_chf(0.0, 1.0, 0.0), 6);
----
0.693147

# Test normal mean
query R
SELECT round(dist_normal_mean(0.0, 1.0), 6);
----
0.000000

# Test normal stddev
query R
SELECT round(dist_normal_stddev(0.0, 1.0), 6);
----
1.000000

# Test normal variance
query R
SELECT round(dist_normal_variance(0.0, 1.0), 6);
----
1.000000

# Test normal mode
query R
SELECT round(dist_normal_mode(0.0, 1.0), 6);
----
0.000000

# Test normal median
query R
SELECT round(dist_normal_median(0.0, 1.0), 6);
----
0.000000

# Test normal skewness
query R
SELECT round(dist_normal_skewness(0.0, 1.0), 6);
----
0.000000

# Test normal kurtosis
query R
SELECT round(dist_normal_kurtosis(0.0, 1.0), 6);
----
3.000000

# Test normal kurtosis_excess
query R
SELECT round(dist_normal_kurtosis_excess(0.0, 1.0), 6);
----
0.000000

# Test normal range executes without error
query I
SELECT dist_normal_range(0.0, 1.0) IS NOT NULL;
----
true

# Test normal support executes without error
query I
SELECT dist_normal_support(0.0, 1.0) IS NOT NULL;
----
true

# Test normal sample returns varying values
query I
SELECT COUNT(DISTINCT dist_normal_sample(0.0, 1.0)) > 1 FROM generate_series(1, 100);
----
true
