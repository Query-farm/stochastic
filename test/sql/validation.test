# name: test/sql/validation.test
# description: parameter validation, boundary quantiles and infinite evaluation points for every univariate distribution
# group: [sql]
# Generated by scripts/generate_tests.py; dist_uniform_int_* are covered by uniform_int.test

require stochastic

# --- arcsine ---

statement error
SELECT dist_arcsine_cdf(1.0, 0.0, 0.25);
----
arcsine: min must be < max, got min=1 max=0

statement error
SELECT dist_arcsine_pdf('nan'::DOUBLE, 1.0, 0.25);
----
arcsine: min must be finite, got nan

statement error
SELECT dist_arcsine_sample('inf'::DOUBLE, 1.0);
----
arcsine: min must be finite, got inf

statement error
SELECT dist_arcsine_mean('-inf'::DOUBLE, 1.0);
----
arcsine: min must be finite, got -inf

statement error
SELECT dist_arcsine_pdf(0.0, 'nan'::DOUBLE, 0.25);
----
arcsine: max must be finite, got nan

statement error
SELECT dist_arcsine_sample(0.0, 'inf'::DOUBLE);
----
arcsine: max must be finite, got inf

statement error
SELECT dist_arcsine_mean(0.0, '-inf'::DOUBLE);
----
arcsine: max must be finite, got -inf

statement error
SELECT dist_arcsine_quantile(0.0, 1.0, 1.5);
----
arcsine: Probability argument is 1.5, but must be >= 0 and <= 1

statement error
SELECT dist_arcsine_quantile(0.0, 1.0, 'nan'::DOUBLE);
----
arcsine: 

query R
SELECT dist_arcsine_quantile(0.0, 1.0, 0.0);
----
0.0

query R
SELECT dist_arcsine_quantile(0.0, 1.0, 1.0);
----
1.0

query R
SELECT dist_arcsine_quantile_complement(0.0, 1.0, 1.0);
----
0.0

query R
SELECT dist_arcsine_quantile_complement(0.0, 1.0, 0.0);
----
1.0

query RRRR
SELECT dist_arcsine_cdf(0.0, 1.0, '-inf'::DOUBLE), dist_arcsine_cdf(0.0, 1.0, 'inf'::DOUBLE), dist_arcsine_pdf(0.0, 1.0, '-inf'::DOUBLE), dist_arcsine_pdf(0.0, 1.0, 'inf'::DOUBLE);
----
0.0	1.0	0.0	0.0

statement error
SELECT dist_arcsine_cdf(0.0, 1.0, 'nan'::DOUBLE);
----
arcsine: 

# --- bernoulli ---

statement error
