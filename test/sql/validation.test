----
bernoulli: prob must be between 0 and 1, got 1.5

statement error
SELECT dist_bernoulli_pdf('nan'::DOUBLE, 1);
----
bernoulli: prob must be finite, got nan

statement error
SELECT dist_bernoulli_sample('inf'::DOUBLE);
----
bernoulli: prob must be finite, got inf

statement error
SELECT dist_bernoulli_mean('-inf'::DOUBLE);
----
bernoulli: prob must be finite, got -inf

statement error
SELECT dist_bernoulli_quantile(0.5, 1.5);
----
bernoulli: Probability argument is 1.5, but must be >= 0 and <= 1

statement error
SELECT dist_bernoulli_quantile(0.5, 'nan'::DOUBLE);
----
bernoulli: 

query R
SELECT dist_bernoulli_quantile(0.5, 0.0);
----
0.0

query R
SELECT dist_bernoulli_quantile(0.5, 1.0);
----
1.0

query R
SELECT dist_bernoulli_quantile_complement(0.5, 1.0);
----
0.0

query R
SELECT dist_bernoulli_quantile_complement(0.5, 0.0);
----
1.0

