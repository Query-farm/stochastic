# name: test/sql/fits.test
# description: dist_fits ranks several fits of one sample by AIC
# group: [sql]

require stochastic

statement ok
CREATE TABLE repair_hours AS
SELECT * FROM (VALUES (1.2), (0.7), (2.9), (1.8), (0.4), (3.6), (1.1), (2.2),
                      (5.3), (0.9), (1.6), (2.4), (0.8), (3.1), (1.4)) t(hours);

# By default every continuous fit except the standard Student's t is tried; beta is left out because the values
# are not all in (0, 1)
query T
SELECT list_transform(dist_fits(hours), lambda f: f.distribution) FROM repair_hours;
----
[inverse_gaussian, rayleigh, lognormal, gamma, weibull, inverse_gamma, extreme_value, chi_squared, uniform_real, exponential, logistic, normal, laplace, cauchy, pareto]

# Each row is the same fit as the distribution's own fit function
query IIIII
WITH ranked AS (SELECT unnest(dist_fits(hours), recursive := true) FROM repair_hours),
own AS (SELECT dist_gamma_fit(hours) g, dist_weibull_fit(hours) w, dist_lognormal_fit(hours) l FROM repair_hours)
SELECT
  bool_and(CASE distribution
    WHEN 'gamma' THEN parameters['shape'] = g.shape AND parameters['scale'] = g.scale AND aic = g.aic AND bic = g.bic
    WHEN 'weibull' THEN parameters['shape'] = w.shape AND parameters['scale'] = w.scale AND log_likelihood = w.log_likelihood
    WHEN 'lognormal' THEN parameters['mean'] = l.mean AND parameters['stddev'] = l.stddev AND aic = l.aic
    ELSE true END),
  count(*),
  min(delta_aic),
  abs(sum(aic_weight) - 1) < 1e-12,
  bool_and(abs(aic_weight - exp(-delta_aic / 2) / (SELECT sum(exp(-delta_aic / 2)) FROM ranked)) < 1e-15)
FROM ranked, own;
----
true	15	0.0	true	true

# Ordered by AIC, and delta_aic is the difference from the best
query II
SELECT list_sort(list_transform(f, lambda x: x.aic)) = list_transform(f, lambda x: x.aic),
       list_transform(f, lambda x: x.aic - f[1].aic) = list_transform(f, lambda x: x.delta_aic)
FROM (SELECT dist_fits(hours) f FROM repair_hours);
----
true	true

# Named candidates, in any order
query TRRR
SELECT distribution, round(aic, 2), round(bic, 2), round(aic_weight, 4)
FROM (SELECT unnest(dist_fits(hours, ['normal', 'exponential', 'weibull', 'lognormal', 'gamma']), recursive := true) FROM repair_hours);
----
lognormal	48.5	49.92	0.3537
gamma	48.65	50.07	0.3279
weibull	49.28	50.7	0.2393
exponential	52.19	52.9	0.056
normal	53.96	55.38	0.0231

query T
SELECT list_transform(dist_fits(hours, ['students_t', 'normal']), lambda f: f.distribution) FROM repair_hours;
----
[normal, students_t]

# Candidates whose support does not cover the values are left out
query T
SELECT list_sort(list_transform(dist_fits(x), lambda f: f.distribution)) FROM (VALUES (-1.5), (0.5), (2.0), (0.1), (-0.3)) t(x);
----
[cauchy, extreme_value, laplace, logistic, normal, uniform_real]

query T
SELECT list_transform(dist_fits(x, ['gamma', 'normal']), lambda f: f.distribution) FROM (VALUES (-1.5), (0.5), (2.0)) t(x);
----
[normal]

# The beta is tried only when every value is in (0, 1)
query II
SELECT list_contains(list_transform(dist_fits(x), lambda f: f.distribution), 'beta'),
       list_contains(list_transform(dist_fits(x + 1), lambda f: f.distribution), 'beta')
FROM (VALUES (0.2), (0.5), (0.35), (0.9), (0.6)) t(x);
----
true	false

# Discrete candidates
query TT
SELECT f.distribution, f.parameters
FROM (SELECT unnest(dist_fits(x, ['poisson', 'negative_binomial', 'geometric'])) f FROM (VALUES (1), (3), (0), (7), (2), (2)) t(x));
----
geometric	{prob=0.2857142857142857}
poisson	{rate=2.5}
negative_binomial	{successes=3.0, prob=0.5454545454545454}

query T
SELECT list_transform(dist_fits(x, ['poisson', 'bernoulli']), lambda f: f.distribution) FROM (VALUES (1), (3), (0)) t(x);
----
[poisson]

# NULLs are ignored; no values, or values no candidate fits, give NULL
query II
SELECT dist_fits(x) IS NULL, dist_fits(x, ['gamma']) IS NULL FROM (SELECT NULL::DOUBLE x);
----
true	true

query I
SELECT dist_fits(x, ['gamma', 'weibull']) IS NULL FROM (VALUES (-1.0), (2.0)) t(x);
----
true

query I
SELECT len(dist_fits(x)) FROM (VALUES (1.0), (NULL), (2.0), (4.0)) t(x);
----
15

# Groups, and the same result whatever the parallelism
query II
SELECT g, list_transform(dist_fits(x, ['exponential', 'normal']), lambda f: f.distribution)[1]
FROM (SELECT i % 2 g, CASE WHEN i % 2 = 0 THEN -ln((i + 0.5) / 20000) ELSE 5 + sin(i) END x FROM range(20000) r(i))
GROUP BY g ORDER BY g;
----
0	exponential
1	normal

query II
WITH a AS (SELECT dist_fits(x) f FROM (SELECT -ln((i + 0.5) / 100000) * 2 x FROM range(100000) r(i))),
     b AS (SELECT dist_fits(x) f FROM (SELECT -ln((i + 0.5) / 100000) * 2 x FROM range(100000) r(i) ORDER BY i DESC))
SELECT list_transform(a.f, lambda r: r.distribution) = list_transform(b.f, lambda r: r.distribution),
       list_max(list_transform(list_zip(a.f, b.f), lambda p: abs(p[1].aic - p[2].aic) / abs(p[1].aic))) < 1e-9
FROM a, b;
----
true	true

# Errors
statement error
SELECT dist_fits(hours, ['gamma', 'poisson']) FROM repair_hours;
----
dist_fits: cannot compare discrete and continuous candidates ('gamma' and 'poisson'), because their likelihoods are not comparable

statement error
SELECT dist_fits(hours, ['gama']) FROM repair_hours;
----
dist_fits: unknown candidate 'gama'; the continuous candidates are normal, lognormal

statement error
SELECT dist_fits(hours, ['gamma', 'gamma']) FROM repair_hours;
----
dist_fits: candidate 'gamma' is listed more than once

statement error
SELECT dist_fits(hours, []::VARCHAR[]) FROM repair_hours;
----
dist_fits: candidates must not be empty

statement error
SELECT dist_fits(hours, ['gamma', NULL]) FROM repair_hours;
----
dist_fits: candidates must not contain NULL

statement error
SELECT dist_fits(hours, NULL) FROM repair_hours;
----

statement error
SELECT dist_fits(hours, [CASE WHEN hours > 1 THEN 'gamma' ELSE 'normal' END]) FROM repair_hours;
----

statement error
SELECT dist_fits(x) FROM (VALUES (1.0), ('inf'::DOUBLE)) t(x);
----
dist_fits: fit values must be finite, got inf
