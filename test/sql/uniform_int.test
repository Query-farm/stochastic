# name: test/sql/uniform_int.test
# description: inclusive discrete uniform analytics, sampling and validation
# group: [sql]

require stochastic

# A fair die has six equally likely outcomes, including both endpoints.
query RRRR
SELECT round(dist_uniform_int_pdf(1,6,3), 9), dist_uniform_int_cdf(1,6,3),
       dist_uniform_int_mean(1,6), round(dist_uniform_int_variance(1,6), 9);
----
0.166666667	0.5	3.5	2.916666667

query TTTT
SELECT typeof(dist_uniform_int_mean(1,6)), typeof(dist_uniform_int_variance(1,6)),
       typeof(dist_uniform_int_stddev(1,6)), typeof(dist_uniform_int_median(1,6));
----
DOUBLE	DOUBLE	DOUBLE	DOUBLE

query RRRRR
SELECT round(dist_uniform_int_stddev(1,6),9), dist_uniform_int_median(1,6),
       dist_uniform_int_skewness(1,6), round(dist_uniform_int_kurtosis(1,6),9),
       round(dist_uniform_int_kurtosis_excess(1,6),9);
----
1.707825128	3.5	0.0	1.731428571	-1.268571429

query I
SELECT dist_uniform_int_mode(1,6);
----
1

# Vectorized, inclusive tails, values outside support, and NULL input.
query IRRR rowsort
SELECT x, round(dist_uniform_int_pdf(1,6,x),6), round(dist_uniform_int_cdf(1,6,x),6),
       round(dist_uniform_int_cdf_complement(1,6,x),6)
FROM (VALUES (0),(1),(3),(6),(7),(NULL)) t(x);
----
0	0.0	0.0	1.0
1	0.166667	0.166667	0.833333
3	0.166667	0.5	0.5
6	0.166667	1.0	0.0
7	0.0	1.0	0.0
NULL	NULL	NULL	NULL

query RRRR
SELECT round(dist_uniform_int_log_pdf(1,6,3),9), round(dist_uniform_int_log_cdf(1,6,3),9),
       round(dist_uniform_int_log_cdf_complement(1,6,3),9), round(dist_uniform_int_chf(1,6,3),9);
----
-1.791759469	-0.693147181	-0.693147181	0.693147181

query IIII
SELECT isinf(dist_uniform_int_log_pdf(1,6,0)), isinf(dist_uniform_int_log_cdf(1,6,0)),
       isinf(dist_uniform_int_log_cdf_complement(1,6,6)), isinf(dist_uniform_int_chf(1,6,6));
----
true	true	true	true

# Discrete hazard is P(X=x)/P(X>=x), including one at the upper endpoint.
query RRR
SELECT dist_uniform_int_hazard(1,6,0), dist_uniform_int_hazard(1,6,2), dist_uniform_int_hazard(1,6,6);
----
0.0	0.2	1.0

statement error
SELECT dist_uniform_int_hazard(1,6,7);
----
hazard is undefined above the maximum

# Smallest supported integer whose CDF reaches p; complementary tail avoids 1-p.
query RII
SELECT p, dist_uniform_int_quantile(1,6,p), dist_uniform_int_quantile_complement(1,6,p)
FROM (VALUES (0.0),(0.05),(0.5),(0.95),(1.0)) t(p) ORDER BY p;
----
0.0	1	6
0.05	1	6
0.5	3	3
0.95	6	1
1.0	6	1

query III
SELECT dist_uniform_int_quantile(-6,-1,0.95),
       dist_uniform_int_quantile(1,6,1.0/6), dist_uniform_int_quantile(1,6,0.166666667);
----
-1	1	2

# Varying bounds exercise general vector paths; support arrays preserve NULLs.
query RRTT
SELECT dist_uniform_int_mean(a,b), dist_uniform_int_variance(a,b),
       dist_uniform_int_range(a,b), dist_uniform_int_support(a,b)
FROM (VALUES (1,6),(-2,2),(7,7),(NULL,6),(1,NULL)) t(a,b);
----
3.5	2.916666667	[1, 6]	[1, 6]
0.0	2.0	[-2, 2]	[-2, 2]
7.0	0.0	[7, 7]	[7, 7]
NULL	NULL	NULL	NULL
NULL	NULL	NULL	NULL

query RRRII
SELECT dist_uniform_int_pdf(7,7,7), dist_uniform_int_cdf(7,7,7),
       dist_uniform_int_cdf_complement(7,7,7), dist_uniform_int_quantile(7,7,0.5), dist_uniform_int_sample(7,7);
----
1.0	1.0	0.0	7	7

statement error
SELECT dist_uniform_int_kurtosis(7,7);
----
standardized moments are undefined

statement error
SELECT dist_uniform_int_skewness(7,7);
----
standardized moments are undefined

# Sampling remains integer-valued on the same support.
query II
SELECT bool_and(x BETWEEN 1 AND 6), count(DISTINCT x) > 1
FROM (SELECT dist_uniform_int_sample(1,6) AS x FROM range(1000));
----
true	true

query I
SELECT bool_and(x = a) FROM (
  SELECT a, dist_uniform_int_sample(a,a) AS x FROM range(-100,100) t(a)
);
----
true

# No signed subtraction overflow for a wide interval and no unsafe DOUBLE cast.
query II
SELECT dist_uniform_int_quantile(-9007199254740992,9007199254740992,0) = -9007199254740992,
       dist_uniform_int_quantile(-9007199254740992,9007199254740992,1) = 9007199254740992;
----
true	true

query I
SELECT isfinite(dist_uniform_int_variance(-9223372036854775808,9223372036854774784));
----
true

statement error
SELECT dist_uniform_int_pdf(6,1,3);
----
bounds must be finite BIGINT integers with min <= max

statement error
SELECT dist_uniform_int_sample(1.5,6);
----
bounds must be finite BIGINT integers with min <= max

statement error
SELECT dist_uniform_int_mean('nan'::DOUBLE,6);
----
bounds must be finite BIGINT integers with min <= max

statement error
SELECT dist_uniform_int_sample(1,'inf'::DOUBLE);
----
bounds must be finite BIGINT integers with min <= max

statement error
SELECT dist_uniform_int_range(-1e20,1);
----
bounds must be finite BIGINT integers with min <= max

statement error
SELECT dist_uniform_int_sample(1,9223372036854775808);
----
bounds must be finite BIGINT integers with min <= max

statement error
SELECT dist_uniform_int_quantile(1,6,-0.1);
----
probability must be finite and between 0 and 1

statement error
SELECT dist_uniform_int_quantile_complement(1,6,-0.1);
----
probability must be finite and between 0 and 1

statement error
SELECT dist_uniform_int_quantile(1,6,1.1);
----
probability must be finite and between 0 and 1

statement error
SELECT dist_uniform_int_quantile_complement(1,6,1.1);
----
probability must be finite and between 0 and 1

statement error
SELECT dist_uniform_int_quantile(1,6,'nan'::DOUBLE);
----
probability must be finite and between 0 and 1

statement error
SELECT dist_uniform_int_quantile_complement(1,6,'nan'::DOUBLE);
----
probability must be finite and between 0 and 1

statement error
SELECT dist_uniform_int_quantile(1,6,'inf'::DOUBLE);
----
probability must be finite and between 0 and 1

statement error
SELECT dist_uniform_int_quantile_complement(1,6,'inf'::DOUBLE);
----
probability must be finite and between 0 and 1

# Exact integer ranks across the DOUBLE precision boundary, including signed span.
query IIII
SELECT dist_uniform_int_quantile(-9007199254740992,9007199254740992,0.5),
       dist_uniform_int_quantile_complement(-9007199254740992,9007199254740992,0.5),
       dist_uniform_int_quantile(-9223372036854775808,9223372036854774784,0.5),
       dist_uniform_int_quantile_complement(-9223372036854775808,9223372036854774784,0.5);
----
0	0	-512	-512

# Positive subnormal tails still identify endpoint integers, without large shifts.
query II
SELECT dist_uniform_int_quantile(-6,-1,'5e-324'::DOUBLE),
       dist_uniform_int_quantile_complement(-6,-1,'5e-324'::DOUBLE);
----
-6	-1

# p uses its exact binary DOUBLE value: 0.1 is slightly above one tenth.
query II
SELECT dist_uniform_int_quantile(1,10,0.1), dist_uniform_int_quantile_complement(1,10,0.1);
----
2	9

# Varying all parameters exercises the ternary executor and NULL propagation.
query IRR
SELECT dist_uniform_int_quantile(a,b,p), dist_uniform_int_pdf(a,b,x), dist_uniform_int_cdf(a,b,x)
FROM (VALUES (1,6,0.5,3),(-2,2,0.5,0),(7,7,0.5,7),(NULL,2,0.5,0),(1,6,NULL,3)) t(a,b,p,x);
----
3	0.166666667	0.5
0	0.2	0.6
7	1.0	1.0
NULL	NULL	NULL
NULL	0.166666667	0.5
